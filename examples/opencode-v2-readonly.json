{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    }
  ]
}
